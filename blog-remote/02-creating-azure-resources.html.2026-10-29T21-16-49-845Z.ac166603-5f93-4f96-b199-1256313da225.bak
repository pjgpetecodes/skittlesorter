<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$subscriptionId = az account show --query id -o tsv
$location = "eastus"
$unique = "dev001"             # make it unique

$resourceGroup = "$unique-skittlesorter-rg"
$iotHubName = "$unique-skittlesorter-hub"   # must be globally unique
$dpsName = "$unique-skittlesorter-dps"      # must be globally unique
$adrNamespace = "$unique-skittlesorter-adr" # lowercase only
$credentialPolicyName = "cert-policy"
$userIdentity = "$unique-skittlesorter-uami"
$enrollmentGroupName = "$unique-skittlesorter-group"
$registrationId = "$unique-skittlesorter"</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">subscriptionId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> az account show </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">query id </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">o tsv</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">location</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">eastus</span><span style="color: #ECEFF4">&quot;</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">unique</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">dev001</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF">             </span><span style="color: #616E88"># make it unique</span></span>
<span class="line"></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">unique</span><span style="color: #A3BE8C">-skittlesorter-rg</span><span style="color: #ECEFF4">&quot;</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">iotHubName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">unique</span><span style="color: #A3BE8C">-skittlesorter-hub</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF">   </span><span style="color: #616E88"># must be globally unique</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">unique</span><span style="color: #A3BE8C">-skittlesorter-dps</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF">      </span><span style="color: #616E88"># must be globally unique</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">adrNamespace</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">unique</span><span style="color: #A3BE8C">-skittlesorter-adr</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #616E88"># lowercase only</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">credentialPolicyName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">cert-policy</span><span style="color: #ECEFF4">&quot;</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">userIdentity</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">unique</span><span style="color: #A3BE8C">-skittlesorter-uami</span><span style="color: #ECEFF4">&quot;</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">enrollmentGroupName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">unique</span><span style="color: #A3BE8C">-skittlesorter-group</span><span style="color: #ECEFF4">&quot;</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">registrationId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">unique</span><span style="color: #A3BE8C">-skittlesorter</span><span style="color: #ECEFF4">&quot;</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p>Now we create the container for everything.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"az group create \u002d\u002dname $resourceGroup \u002d\u002dlocation $location","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz group create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003elocation \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003elocation\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>az group create --name $resourceGroup --location $location</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">az group create </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">location </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">location</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Step 2: Configure App Privileges</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Now we configure App Privileges (IoT Hub app principal)</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"az role assignment create `\n        \u002d\u002dassignee \u002289d10474-74af-4874-99a7-c23c2f643083\u0022 `\n        \u002d\u002drole \u0022Contributor\u0022 `\n        \u002d\u002dscope \u0022/subscriptions/$subscriptionId/resourceGroups/$resourceGroup \u0022 `\n        \u002d\u002doutput none 2\u003e$null","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz role assignment create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eassignee \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e89d10474-74af-4874-99a7-c23c2f643083\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003erole \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003eContributor\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003escope \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e/subscriptions/\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003esubscriptionId\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e/resourceGroups/\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eoutput none \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e2\u0026gt;$null\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","seeMoreType":"","seeMoreString":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>az role assignment create `
        --assignee "89d10474-74af-4874-99a7-c23c2f643083" `
        --role "Contributor" `
        --scope "/subscriptions/$subscriptionId/resourceGroups/$resourceGroup " `
        --output none 2>$null</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">az role assignment create </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">assignee </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">89d10474-74af-4874-99a7-c23c2f643083</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">role </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">Contributor</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">scope </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">/subscriptions/</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">subscriptionId</span><span style="color: #A3BE8C">/resourceGroups/</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #A3BE8C"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">output none </span><span style="color: #81A1C1">2&gt;$null</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading" id="step-5-create-managed-identity-and-assign-roles">Step 3: Create Managed Identity and Assign Roles</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>We need permissions for DPS and IoT Hub to read ADR. Now we create UAMI and grant access.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>First we create a reusable Azure managed identity so IoT Hub and DPS can securely access ADR without storing secrets.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"az identity create `\n        \u002d\u002dname $userIdentity `\n        \u002d\u002dresource-group $resourceGroup `\n        \u002d\u002dlocation $location `\n        \u002d\u002doutput none","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz identity create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003euserIdentity\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003elocation \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003elocation\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eoutput none\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","seeMoreType":"","seeMoreString":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>az identity create `
        --name $userIdentity `
        --resource-group $resourceGroup `
        --location $location `
        --output none</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">az identity create </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">userIdentity</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">location </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">location</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">output none</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p>Now we retrieve the managed identity’s resource ID and save it to <code>$uamiResourceId</code> so we can attach that identity to IoT Hub and DPS in the next steps.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$uamiResourceId = az identity show `\n        \u002d\u002dname $userIdentity `\n        \u002d\u002dresource-group $resourceGroup `\n        \u002d\u002dquery id -o tsv","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003euamiResourceId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e az identity show \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003euserIdentity\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003equery id \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eo tsv\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","seeMoreType":"","seeMoreString":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$uamiResourceId = az identity show `
        --name $userIdentity `
        --resource-group $resourceGroup `
        --query id -o tsv</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">uamiResourceId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> az identity show </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">userIdentity</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">query id </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">o tsv</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p>Now we retrieve the managed identity’s principal ID and store it in <code>$uamiPrincipalId</code> so we can grant it RBAC permissions on ADR.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$uamiPrincipalId = az identity show `\n        \u002d\u002dname $userIdentity `\n        \u002d\u002dresource-group $resourceGroup `\n        \u002d\u002dquery principalId -o tsv","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003euamiPrincipalId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e az identity show \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003euserIdentity\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003equery principalId \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eo tsv\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","seeMoreType":"","seeMoreString":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$uamiPrincipalId = az identity show `
        --name $userIdentity `
        --resource-group $resourceGroup `
        --query principalId -o tsv</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">uamiPrincipalId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> az identity show </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">userIdentity</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">query principalId </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">o tsv</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading" id="step-4-create-adr-namespace--credential-policy">Step 4: Create ADR Namespace + Credential Policy</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>ADR backs certificate issuance. We create the namespace and a policy that uses Microsoft-managed CA.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Create ADR namespace:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"az iot adr ns create `\n  \u002d\u002dname $adrNamespace `\n  \u002d\u002dresource-group $resourceGroup `\n  \u002d\u002dlocation $location `\n  \u002d\u002dcertificate-authority-name microsoft-managed `\n  \u002d\u002didentity-type SystemAssigned","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz iot adr ns create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eadrNamespace\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003elocation \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003elocation\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecertificate\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eauthority\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename microsoft\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003emanaged \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eidentity\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003etype SystemAssigned\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>az iot adr ns create `
  --name $adrNamespace `
  --resource-group $resourceGroup `
  --location $location `
  --certificate-authority-name microsoft-managed `
  --identity-type SystemAssigned</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">az iot adr ns create </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">adrNamespace</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">location </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">location</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">certificate</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">authority</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name microsoft</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">managed </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">identity</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">type SystemAssigned</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p>Now we retrieve the Device Registry Namespace Resource ID.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$namespaceResourceId = az iot adr ns show `\n        \u002d\u002dname $adrNamespace `\n        \u002d\u002dresource-group $resourceGroup `\n        \u002d\u002dquery id -o tsv","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003enamespaceResourceId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e az iot adr ns show \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eadrNamespace\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003equery id \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eo tsv\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","seeMoreType":"","seeMoreString":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$namespaceResourceId = az iot adr ns show `
        --name $adrNamespace `
        --resource-group $resourceGroup `
        --query id -o tsv</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">namespaceResourceId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> az iot adr ns show </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">adrNamespace</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">query id </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">o tsv</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p>Now we grant the managed identity the ADR contributor role at the namespace scope so it has permission to access and operate on that ADR namespace.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"# Assign UAMI role to access the ADR namespace\naz role assignment create `\n        \u002d\u002dassignee $uamiPrincipalId `\n        \u002d\u002drole \u0022a5c3590a-3a1a-4cd4-9648-ea0a32b15137\u0022 `\n        \u002d\u002dscope $namespaceResourceId `\n        \u002d\u002doutput none","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #616E88\u0022\u003e# Assign UAMI role to access the ADR namespace\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz role assignment create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eassignee \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003euamiPrincipalId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003erole \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003ea5c3590a-3a1a-4cd4-9648-ea0a32b15137\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003escope \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003enamespaceResourceId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eoutput none\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","seeMoreType":"","seeMoreString":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly># Assign UAMI role to access the ADR namespace
az role assignment create `
        --assignee $uamiPrincipalId `
        --role "a5c3590a-3a1a-4cd4-9648-ea0a32b15137" `
        --scope $namespaceResourceId `
        --output none</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #616E88"># Assign UAMI role to access the ADR namespace</span></span>
<span class="line"><span style="color: #D8DEE9FF">az role assignment create </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">assignee </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">uamiPrincipalId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">role </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">a5c3590a-3a1a-4cd4-9648-ea0a32b15137</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">scope </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">namespaceResourceId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">output none</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading" id="step-2-create-iot-hub">Step 5: Create IoT Hub</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Now it's time to create the IoT Hub where our devices will land after DPS assigns them. We need to use S1 as the preview features need Standard.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"az iot hub create `\n        \u002d\u002dname $ioTHubName `\n        \u002d\u002dresource-group $resourceGroup `\n        \u002d\u002dlocation $location `\n        \u002d\u002dsku s1 `\n        \u002d\u002dmi-user-assigned $uamiResourceId `\n        \u002d\u002dns-resource-id $namespaceResourceId `\n        \u002d\u002dns-identity-id $uamiResourceId `\n        \u002d\u002doutput none","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz iot hub create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eioTHubName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003elocation \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003elocation\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003esku s1 \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003emi\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003euser\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eassigned \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003euamiResourceId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ens\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eid \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003enamespaceResourceId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ens\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eidentity\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eid \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003euamiResourceId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eoutput none\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>az iot hub create `
        --name $ioTHubName `
        --resource-group $resourceGroup `
        --location $location `
        --sku s1 `
        --mi-user-assigned $uamiResourceId `
        --ns-resource-id $namespaceResourceId `
        --ns-identity-id $uamiResourceId `
        --output none</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">az iot hub create </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">ioTHubName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">location </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">location</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">sku s1 </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">mi</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">user</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">assigned </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">uamiResourceId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">ns</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">id </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">namespaceResourceId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">ns</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">identity</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">id </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">uamiResourceId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">output none</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading" id="step-5-create-managed-identity-and-assign-roles">Step 6: Create Managed Identity and Assign Roles</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>We need permissions for DPS and IoT Hub to read ADR. Now we create UAMI and grant access.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>Now we fetch the ADR namespace’s managed identity principal ID and store it in <code>$adrPrincipalId</code> so we can grant that identity access to IoT Hub.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$adrPrincipalId = az iot adr ns show `\n        \u002d\u002dname $adrNamespace `\n        \u002d\u002dresource-group $resourceGroup `\n        \u002d\u002dquery identity.principalId -o tsv","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eadrPrincipalId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e az iot adr ns show \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eadrNamespace\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003equery identity.principalId \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eo tsv\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","seeMoreType":"","seeMoreString":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$adrPrincipalId = az iot adr ns show `
        --name $adrNamespace `
        --resource-group $resourceGroup `
        --query identity.principalId -o tsv</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">adrPrincipalId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> az iot adr ns show </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">adrNamespace</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">query identity.principalId </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">o tsv</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p>Now we grant the ADR namespace identity Contributor access on the IoT Hub so ADR can manage required hub-side resources during provisioning.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"az role assignment create `\n        \u002d\u002dassignee $adrPrincipalId `\n        \u002d\u002drole \u0022Contributor\u0022 `\n        \u002d\u002dscope $hubResourceId `\n        \u002d\u002doutput none","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz role assignment create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eassignee \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eadrPrincipalId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003erole \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003eContributor\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003escope \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ehubResourceId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eoutput none\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","seeMoreType":"","seeMoreString":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>az role assignment create `
        --assignee $adrPrincipalId `
        --role "Contributor" `
        --scope $hubResourceId `
        --output none</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">az role assignment create </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">assignee </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">adrPrincipalId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">role </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">Contributor</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">scope </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">hubResourceId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">output none</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p>Now we grant the ADR namespace identity the IoT Hub Registry Contributor role so it can create and manage device identities during provisioning.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"az role assignment create `\n        \u002d\u002dassignee $adrPrincipalId `\n        \u002d\u002drole \u0022IoT Hub Registry Contributor\u0022 `\n        \u002d\u002dscope $hubResourceId `\n        \u002d\u002doutput none","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz role assignment create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eassignee \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eadrPrincipalId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003erole \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003eIoT Hub Registry Contributor\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003escope \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ehubResourceId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eoutput none\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","seeMoreType":"","seeMoreString":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
