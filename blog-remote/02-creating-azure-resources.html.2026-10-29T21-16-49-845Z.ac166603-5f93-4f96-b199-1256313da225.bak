<span class="line"><span style="color: #D8DEE9FF">      </span><span style="color: #ECEFF4">&quot;</span><span style="color: #8FBCBB">AttestationCertPath</span><span style="color: #ECEFF4">&quot;</span><span style="color: #ECEFF4">:</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">C:</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">path</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">to</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">scripts</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">certs</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">device</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">device.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #ECEFF4">,</span></span>
<span class="line"><span style="color: #D8DEE9FF">      </span><span style="color: #ECEFF4">&quot;</span><span style="color: #8FBCBB">AttestationKeyPath</span><span style="color: #ECEFF4">&quot;</span><span style="color: #ECEFF4">:</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">C:</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">path</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">to</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">scripts</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">certs</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">device</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">device.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #ECEFF4">,</span></span>
<span class="line"><span style="color: #D8DEE9FF">      </span><span style="color: #ECEFF4">&quot;</span><span style="color: #8FBCBB">AttestationCertChainPath</span><span style="color: #ECEFF4">&quot;</span><span style="color: #ECEFF4">:</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">C:</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">path</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">to</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">scripts</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">certs</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">ca</span><span style="color: #EBCB8B">\\</span><span style="color: #A3BE8C">chain.pem</span><span style="color: #ECEFF4">&quot;</span></span>
