roicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>az iot dps create `
        --name $dPSName `
        --resource-group $resourceGroup `
        --location $location `
        --mi-user-assigned $uamiResourceId `
        --ns-resource-id $namespaceResourceId `
        --ns-identity-id $uamiResourceId `
        --output none</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">az iot dps create </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dPSName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">location </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">location</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">mi</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">user</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">assigned </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">uamiResourceId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">ns</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">id </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">namespaceResourceId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">ns</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">identity</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">id </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">uamiResourceId</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">output none</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Get DPS ID Scope:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$idScope = az iot dps show `\n  \u002d\u002dname $dpsName `\n  \u002d\u002dresource-group $resourceGroup `\n  \u002d\u002dquery properties.idScope -o tsv\n\nWrite-Host \u0022DPS ID Scope: $idScope\u0022 -ForegroundColor Green","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eidScope\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e az iot dps show \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003edpsName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003equery properties.idScope \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eo tsv\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eWrite-Host\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003eDPS ID Scope: \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eidScope\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eForegroundColor Green\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$idScope = az iot dps show `
  --name $dpsName `
  --resource-group $resourceGroup `
  --query properties.idScope -o tsv

Write-Host "DPS ID Scope: $idScope" -ForegroundColor Green</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">idScope</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> az iot dps show </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">query properties.idScope </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">o tsv</span></span>
<span class="line"></span>
<span class="line"><span style="color: #88C0D0">Write-Host</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">DPS ID Scope: </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">idScope</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">ForegroundColor Green</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading" id="step-6-link-dps-to-iot-hub-and-adr">Step 8: Link DPS to IoT Hub and ADR</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Onwards we wire everything together.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"az iot dps linked-hub create `\n        \u002d\u002ddps-name $dpsName `\n        \u002d\u002dresource-group $resourceGroup `\n        \u002d\u002dhub-name $ioTHubName `\n        \u002d\u002doutput none","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz iot dps linked\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ehub create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edps\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003edpsName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ehub\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eioTHubName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eoutput none\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>az iot dps linked-hub create `
        --dps-name $dpsName `
        --resource-group $resourceGroup `
        --hub-name $ioTHubName `
        --output none</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">az iot dps linked</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">hub create </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">dps</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">hub</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">ioTHubName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">        </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">output none</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading" id="step-7-sync-credential-policy">Step 9: Sync Credential Policy</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Next up we sync ADR credentials into IoT Hub so certs verify correctly.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Sync credential policy to IoT Hub:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"az iot adr ns credential sync `\n        \u002d\u002dnamespace $adrNamespace `\n        \u002d\u002dresource-group $resourceGroup `\n        \u002d\u002doutput json 2\u003e\u0026amp;1","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz iot adr ns credential sync \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003enamespace \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eadrNamespace\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e        \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eoutput json \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e2\u0026gt;\u0026amp;1\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>az iot adr ns credential sync `
