<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading" id="update-device-configuration">Update Device Configuration</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Once the script completes, update your device settings:</p>
<!-- /wp:paragraph -->

