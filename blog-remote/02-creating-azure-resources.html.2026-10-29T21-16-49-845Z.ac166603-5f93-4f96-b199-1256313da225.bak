<!-- wp:separator -->
<hr class="wp-block-separator has-alpha-channel-opacity"/>
<!-- /wp:separator -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading" id="option-2-step-by-step-tutorial-this-series">Option 2: Step-by-Step Tutorial</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Follow along post-by-post to understand&nbsp;<strong>why</strong>&nbsp;and&nbsp;<strong>how</strong>&nbsp;everything works. You'll learn:</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>DPS concepts and architecture</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Azure resource setup</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>X.509 certificate workflows</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>.NET implementation details</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading" id="prerequisites">Prerequisites</h3>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Azure subscription</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Azure CLI + IoT extension (<code>az extension add --name azure-iot --allow-preview</code>)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>PowerShell 7+</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Rights to create resource groups and role assignments</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading" id="what-were-building">What We're Building</h3>
<!-- /wp:heading -->

<!-- wp:list {"ordered":true} -->
<ol class="wp-block-list"><!-- wp:list-item -->
<li>Resource Group (keeps everything together)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>IoT Hub (where devices send telemetry)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>DPS (handles zero-touch provisioning)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>ADR namespace + credential policy (issues certs)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Links + roles so the pieces talk to each other</li>
<!-- /wp:list-item --></ol>
<!-- /wp:list -->

<!-- wp:separator -->
<hr class="wp-block-separator has-alpha-channel-opacity"/>
<!-- /wp:separator -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading" id="step-1-set-variables">Step 1: Set Variables and create the Resource Group</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>We declare names once so you can rerun easily.</p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$subscriptionId = az account show \u002d\u002dquery id -o tsv\n$location = \u0022eastus\u0022\n$unique = \u0022dev001\u0022             # make it unique\n\n$resourceGroup = \u0022$unique-skittlesorter-rg\u0022\n$iotHubName = \u0022$unique-skittlesorter-hub\u0022   # must be globally unique\n$dpsName = \u0022$unique-skittlesorter-dps\u0022      # must be globally unique\n$adrNamespace = \u0022$unique-skittlesorter-adr\u0022 # lowercase only\n$credentialPolicyName = \u0022cert-policy\u0022\n$userIdentity = \u0022$unique-skittlesorter-uami\u0022\n$enrollmentGroupName = \u0022$unique-skittlesorter-group\u0022\n$registrationId = \u0022$unique-skittlesorter\u0022","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003esubscriptionId\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e az account show \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003equery id \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eo tsv\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003elocation\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003eeastus\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eunique\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003edev001\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e             \u003c/span\u003e\u003cspan style=\u0022color: #616E88\u0022\u003e# make it unique\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eunique\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e-skittlesorter-rg\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eiotHubN