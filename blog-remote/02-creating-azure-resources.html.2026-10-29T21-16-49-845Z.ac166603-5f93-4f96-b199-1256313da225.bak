le=\u0022color: #F6F6F4\u0022\u003edps\u003c/span\u003e\u003cspan style=\u0022color: #F286C4\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003eadr.ps1 `\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #F286C4\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003eResourceGroup \u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #E7EE98\u0022\u003emy-iot-rg\u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003e `\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #F286C4\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003eLocation \u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #E7EE98\u0022\u003eeastus\u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003e `\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #F286C4\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003eIoTHubName \u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #E7EE98\u0022\u003emy-hub-001\u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003e `\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #F286C4\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003eDPSName \u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #E7EE98\u0022\u003emy-dps-001\u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003e `\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #F286C4\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003eAdrNamespace \u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #E7EE98\u0022\u003emy-adr-001\u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003e `\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #F286C4\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #F6F6F4\u0022\u003eUserIdentity \u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #E7EE98\u0022\u003emy-uami\u003c/span\u003e\u003cspan style=\u0022color: #DEE492\u0022\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"dracula-soft","bgColor":"#282A36","textColor":"#f6f6f4","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(251, 251, 239, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#f6f6f4;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>git clone https://github.com/pjgpetecodes/skittlesorter.git
cd skittlesorter/scripts

# Full ADR + X.509 setup (recommended)
.\setup-x509-dps-adr.ps1 `
  -ResourceGroup "my-iot-rg" `
  -Location "eastus" `
  -IoTHubName "my-hub-001" `
  -DPSName "my-dps-001" `
  -AdrNamespace "my-adr-001" `
  -UserIdentity "my-uami"</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki dracula-soft" style="background-color: #282A36" tabindex="0"><code><span class="line"><span style="color: #F6F6F4">git clone https:</span><span style="color: #F286C4">//</span><span style="color: #97E1F1">github.com</span><span style="color: #F286C4">/</span><span style="color: #F6F6F4">pjgpetecodes</span><span style="color: #F286C4">/</span><span style="color: #F6F6F4">skittlesorter.git</span></span>
<span class="line"><span style="color: #F6F6F4">cd skittlesorter</span><span style="color: #F286C4">/</span><span style="color: #F6F6F4">scripts</span></span>
<span class="line"></span>
<span class="line"><span style="color: #7B7F8B"># Full ADR + X.509 setup (recommended)</span></span>
<span class="line"><span style="color: #F6F6F4">.\setup</span><span style="color: #F286C4">-</span><span style="color: #F6F6F4">x509</span><span style="color: #F286C4">-</span><span style="color: #F6F6F4">dps</span><span style="color: #F286C4">-</span><span style="color: #F6F6F4">adr.ps1 `</span></span>
<span class="line"><span style="color: #F6F6F4">  </span><span style="color: #F286C4">-</span><span style="color: #F6F6F4">ResourceGroup </span><span style="color: #DEE492">&quot;</span><span style="color: #E7EE98">my-iot-rg</span><span style="color: #DEE492">&quot;</span><span style="color: #F6F6F4"> `</span></span>
<span class="line"><span style="color: #F6F6F4">  </span><span style="color: #F286C4">-</span><span style="color: #F6F6F4">Location </span><span style="color: #DEE492">&quot;</span><span style="color: #E7EE98">eastus</span><span style="color: #DEE492">&quot;</span><span style="color: #F6F6F4"> `</span></span>
<span class="line"><span style="color: #F6F6F4">  </span><span style="color: #F286C4">-</span><span style="color: #F6F6F4">IoTHubName </span><span style="color: #DEE492">&quot;</span><span style="color: #E7EE98">my-hub-001</span><span style="color: #DEE492">&quot;</span><span style="color: #F6F6F4"> `</span></span>
<span class="line"><span style="color: #F6F6F4">  </span><span style="color: #F286C4">-</span><span style="color: #F6F6F4">DPSName </span><span style="color: #DEE492">&quot;</span><span style="color: #E7EE98">my-dps-001</span><span style="color: #DEE492">&quot;</span><span style="color: #F6F6F4"> `</span></span>
<span class="line"><span style="color: #F6F6F4">  </span><span style="color: #F286C4">-</span><span style="color: #F6F6F4">AdrNamespace </span><span style="color: #DEE492">&quot;</span><span style="color: #E7EE98">my-adr-001</span><span style="color: #DEE492">&quot;</span><span style="color: #F6F6F4"> `</span></span>
<span class="line"><span style="color: #F6F6F4">  </span><span style="color: #F286C4">-</span><span style="color: #F6F6F4">UserIdentity </span><span style="color: #DEE492">&quot;</span><span style="color: #E7EE98">my-uami</span><span style="color: #DEE492">&quot;</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p>Rename the fields above to suit your solution, then when you run it, the script will output the following:</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>DPS ID Scope (needed for device config)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Certificate paths (for device authentication)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Azure resource details</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Enrollment group information</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph -->
<p>Or, if you have the Azure resources provisioned already, you can also just run the X.509 Setup script;</p>
<!-- /wp:paragraph -->

