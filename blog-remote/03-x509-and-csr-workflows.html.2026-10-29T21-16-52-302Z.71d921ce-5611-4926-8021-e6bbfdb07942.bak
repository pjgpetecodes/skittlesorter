u003esubj \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e/CN=\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eregistrationId\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e-root\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaddext \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003ebasicConstraints=critical,CA:true,pathlen:1\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaddext \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003ekeyUsage=critical,keyCertSign,cRLSign\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaddext \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003esubjectKeyIdentifier=hash\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaddext \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003eauthorityKeyIdentifier=keyid:always\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>openssl req -x509 -new -nodes -newkey rsa:4096 `
  -keyout "$certDir\root\root-ca.key" `
  -out "$certDir\root\root-ca.pem" `
  -days 3650 -sha256 `
  -subj "/CN=$registrationId-root" `
  -addext "basicConstraints=critical,CA:true,pathlen:1" `
  -addext "keyUsage=critical,keyCertSign,cRLSign" `
  -addext "subjectKeyIdentifier=hash" `
  -addext "authorityKeyIdentifier=keyid:always"</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">openssl req </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">x509 </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">new </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">nodes </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">newkey rsa:</span><span style="color: #B48EAD">4096</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">keyout </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\root-ca.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\root-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">days </span><span style="color: #B48EAD">3650</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">sha256 </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">subj </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">/CN=</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">registrationId</span><span style="color: #A3BE8C">-root</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">addext </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">basicConstraints=critical,CA:true,pathlen:1</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">addext </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">keyUsage=critical,keyCertSign,cRLSign</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">addext </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">subjectKeyIdentifier=hash</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">addext </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">authorityKeyIdentifier=keyid:always</span><span style="color: #ECEFF4">&quot;</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Create intermediate CA private key:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"openssl genrsa -out \u0022$certDir\u005cca\u005cintermediate-ca.key\u0022 4096","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl genrsa \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eout \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.key\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #B48EAD\u0022\u003e4096\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>openssl genrsa -out "$certDir\ca\intermediate-ca.key" 4096</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">openssl genrsa </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #B48EAD">4096</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Create intermediate CA CSR:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"openssl req -new `\n  -key \u0022$certDir\u005cca\u005cintermediate-ca.key\u0022 `\n  -out \u0022$certDir\u005cca\u005cintermediate-ca.csr\u0022 `\n  -subj \u0022/CN=$registrationId-intermediate\u0022","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl req \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003enew \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ekey \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.key\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eout \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.csr\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003esubj \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e/CN=\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eregistrationId\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e-intermediate\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>openssl req -new `
  -key "$certDir\ca\intermediate-ca.key" `
  -out "$certDir\ca\intermediate-ca.csr" `
  -subj "/CN=$registrationId-intermediate"</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">openssl req </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">new </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">key </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.csr</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">subj </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">/CN=</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">registrationId</span><span style="color: #A3BE8C">-intermediate</span><span style="color: #ECEFF4">&quot;</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Create intermediate CA extensions file:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"@\u0022\n[ v3_intermediate ]\nbasicConstraints = critical,CA:true,pathlen:0\nkeyUsage = critical, keyCertSign, cRLSign\nsubjectKeyIdentifier = hash\nauthorityKeyIdentifier = keyid:always,issuer\n\u0022@ | Set-Content -Path \u0022$certDir\u005cca\u005cintermediate-ext.cnf\u0022 -Encoding ASCII","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e@\u0026quot;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u0026#91; v3_intermediate \u0026#93;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003ebasicConstraints = critical,CA:true,pathlen:0\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003ekeyUsage = critical, keyCertSign, cRLSign\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003esubjectKeyIdentifier = hash\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003eauthorityKeyIdentifier = keyid:always,issuer\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;@\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e|\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eSet-Content\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ePath \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ext.cnf\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eEncoding ASCII\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>@"
&#91; v3_intermediate &#93;
basicConstraints = critical,CA:true,pathlen:0
keyUsage = critical, keyCertSign, cRLSign
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
"@ | Set-Content -Path "$certDir\ca\intermediate-ext.cnf" -Encoding ASCII</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #ECEFF4">@&quot;</span></span>
<span class="line"><span style="color: #A3BE8C">&#91; v3_intermediate &#93;</span></span>
<span class="line"><span style="color: #A3BE8C">basicConstraints = critical,CA:true,pathlen:0</span></span>
<span class="line"><span style="color: #A3BE8C">keyUsage = critical, keyCertSign, cRLSign</span></span>
<span class="line"><span style="color: #A3BE8C">subjectKeyIdentifier = hash</span></span>
<span class="line"><span style="color: #A3BE8C">authorityKeyIdentifier = keyid:always,issuer</span></span>
<span class="line"><span style="color: #ECEFF4">&quot;@</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">|</span><span style="color: #D8DEE9FF"> </span><span style="color: #88C0D0">Set-Content</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">Path </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ext.cnf</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">Encoding ASCII</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Sign intermediate CA with root CA:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"openssl x509 -req `\n  -in \u0022$certDir\u005cca\u005cintermediate-ca.csr\u0022 `\n  -CA \u0022$certDir\u005croot\u005croot-ca.pem\u0022 `\n  -CAkey \u0022$certDir\u005croot\u005croot-ca.key\u0022 `\n  -CAcreateserial `\n  -out \u0022$certDir\u005cca\u005cintermediate-ca.pem\u0022 `\n  -days 1825 -sha256 `\n  -extfile \u0022$certDir\u005cca\u005cintermediate-ext.cnf\u0022 \n  -extensions v3_intermediate","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl x509 \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ereq \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-in\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.csr\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eCA \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005croot\u005croot-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eCAkey \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005croot\u005croot-ca.key\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eCAcreateserial \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eout \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edays \u003c/span\u003e\u003cspan style=\u0022color: #B48EAD\u0022\u003e1825\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003esha256 \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eextfile \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ext.cnf\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eextensions v3_intermediate\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>openssl x509 -req `
  -in "$certDir\ca\intermediate-ca.csr" `
  -CA "$certDir\root\root-ca.pem" `
  -CAkey "$certDir\root\root-ca.key" `
  -CAcreateserial `
  -out "$certDir\ca\intermediate-ca.pem" `
  -days 1825 -sha256 `
  -extfile "$certDir\ca\intermediate-ext.cnf" 
  -extensions v3_intermediate</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">openssl x509 </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">req </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-in</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.csr</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">CA </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\root-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">CAkey </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\root-ca.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">CAcreateserial </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">days </span><span style="color: #B48EAD">1825</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">sha256 </span><span style="color: #81A1C1">`</span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">extfile </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ext.cnf</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span></span>
<span class="line"><span style="color: #D8DEE9FF">  </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">extensions v3_intermediate</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p>3<strong>) Extract certificate thumbprints:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Extract root CA thumbprint:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$rootX509 = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2(\u0022$certDir\u005croot\u005croot-ca.pem\u0022)\n$rootThumbprint = $rootX509.Thumbprint","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootX509\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eNew-Object\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e System.Security.Cryptography.X509Certificates.X509Certificate2\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e(\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005croot\u005croot-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e)\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootThumbprint\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootX509.Thumbprint\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$rootX509 = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2("$certDir\root\root-ca.pem")
$rootThumbprint = $rootX509.Thumbprint</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootX509</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #88C0D0">New-Object</span><span style="color: #D8DEE9FF"> System.Security.Cryptography.X509Certificates.X509Certificate2</span><span style="color: #ECEFF4">(</span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\root-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #ECEFF4">)</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootThumbprint</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootX509.Thumbprint</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Extract intermediate CA thumbprint:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$caX509 = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2(\u0022$certDir\u005cca\u005cintermediate-ca.pem\u0022)\n$caThumbprint = $caX509.Thumbprint","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaX509\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eNew-Object\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e System.Security.Cryptography.X509Certificates.X509Certificate2\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e(\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e)\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaThumbprint\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaX509.Thumbprint\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$caX509 = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2("$certDir\ca\intermediate-ca.pem")
$caThumbprint = $caX509.Thumbprint</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caX509</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #88C0D0">New-Object</span><span style="color: #D8DEE9FF"> System.Security.Cryptography.X509Certificates.X509Certificate2</span><span style="color: #ECEFF4">(</span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #ECEFF4">)</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caThumbprint</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caX509.Thumbprint</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>4) Upload and verify root CA with DPS:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Upload root CA to DPS:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$rootCertName = \u0022$registrationId-root\u0022\naz iot dps certificate create \u002d\u002ddps-name $dpsName \u002d\u002dresource-group $resourceGroup \u002d\u002dcertificate-name $rootCertName \u002d\u002dpath \u0022$certDir\u005croot\u005croot-ca.pem\u0022","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootCertName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eregistrationId\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e-root\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz iot dps certificate create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edps\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003edpsName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecertificate\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootCertName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003epath \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005croot\u005croot-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$rootCertName = "$registrationId-root"
az iot dps certificate create --dps-name $dpsName --resource-group $resourceGroup --certificate-name $rootCertName --path "$certDir\root\root-ca.pem"</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootCertName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">registrationId</span><span style="color: #A3BE8C">-root</span><span style="color: #ECEFF4">&quot;</span></span>
<span class="line"><span style="color: #D8DEE9FF">az iot dps certificate create </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">dps</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">certificate</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootCertName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">path </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\root-ca.pem</span><span style="color: #ECEFF4">&quot;</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Get root CA etag and generate verification code:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$rootCert = az iot dps certificate show \u002d\u002ddps-name $dpsName \u002d\u002dresource-group $resourceGroup \u002d\u002dcertificate-name $rootCertName -o json | ConvertFrom-Json\n$rootEtag = $rootCert.properties.etag\n\n$rootVer = az iot dps certificate generate-verification-code \u002d\u002ddps-name $dpsName \u002d\u002dresource-group $resourceGroup \u002d\u002dcertificate-name $rootCertName \u002d\u002detag $rootEtag -o json | ConvertFrom-Json\n$rootVerCode = $rootVer.properties.verificationCode\nWrite-Host \u0022Verification Code: $rootVerCode\u0022 -ForegroundColor Cyan","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootCert\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e az iot dps certificate show \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edps\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003edpsName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecertificate\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootCertName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eo json \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e|\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eConvertFrom-Json\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootEtag\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootCert.properties.etag\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootVer\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e az iot dps certificate generate\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003everification\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecode \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edps\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003edpsName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecertificate\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootCertName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eetag \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootEtag\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eo json \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e|\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eConvertFrom-Json\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootVerCode\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootVer.properties.verificationCode\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eWrite-Host\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003eVerification Code: \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootVerCode\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eForegroundColor Cyan\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$rootCert = az iot dps certificate show --dps-name $dpsName --resource-group $resourceGroup --certificate-name $rootCertName -o json | ConvertFrom-Json
$rootEtag = $rootCert.properties.etag

$rootVer = az iot dps certificate generate-verification-code --dps-name $dpsName --resource-group $resourceGroup --certificate-name $rootCertName --etag $rootEtag -o json | ConvertFrom-Json
$rootVerCode = $rootVer.properties.verificationCode
Write-Host "Verification Code: $rootVerCode" -ForegroundColor Cyan</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootCert</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> az iot dps certificate show </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">dps</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">certificate</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootCertName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">o json </span><span style="color: #81A1C1">|</span><span style="color: #D8DEE9FF"> </span><span style="color: #88C0D0">ConvertFrom-Json</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootEtag</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootCert.properties.etag</span></span>
<span class="line"></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootVer</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> az iot dps certificate generate</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">verification</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">code </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">dps</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">certificate</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootCertName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">etag </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootEtag</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">o json </span><span style="color: #81A1C1">|</span><span style="color: #D8DEE9FF"> </span><span style="color: #88C0D0">ConvertFrom-Json</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootVerCode</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootVer.properties.verificationCode</span></span>
<span class="line"><span style="color: #88C0D0">Write-Host</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">Verification Code: </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootVerCode</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">ForegroundColor Cyan</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Create root CA verification certificate:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"openssl genrsa -out \u0022$certDir\u005croot\u005cverification.key\u0022 2048\nopenssl req -new -key \u0022$certDir\u005croot\u005cverification.key\u0022 -out \u0022$certDir\u005croot\u005cverification.csr\u0022 -subj \u0022/CN=$rootVerCode\u0022\nopenssl x509 -req -in \u0022$certDir\u005croot\u005cverification.csr\u0022 -CA \u0022$certDir\u005croot\u005croot-ca.pem\u0022 -CAkey \u0022$certDir\u005croot\u005croot-ca.key\u0022 -CAcreateserial -out \u0022$certDir\u005croot\u005cverification.pem\u0022 -days 1 -sha256","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl genrsa \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eout \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005croot\u005cverification.key\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #B48EAD\u0022\u003e2048\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl req \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003enew \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ekey \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003csp