e=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005croot\u005cverification.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edays \u003c/span\u003e\u003cspan style=\u0022color: #B48EAD\u0022\u003e1\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003esha256\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>openssl genrsa -out "$certDir\root\verification.key" 2048
openssl req -new -key "$certDir\root\verification.key" -out "$certDir\root\verification.csr" -subj "/CN=$rootVerCode"
openssl x509 -req -in "$certDir\root\verification.csr" -CA "$certDir\root\root-ca.pem" -CAkey "$certDir\root\root-ca.key" -CAcreateserial -out "$certDir\root\verification.pem" -days 1 -sha256</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">openssl genrsa </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\verification.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #B48EAD">2048</span></span>
<span class="line"><span style="color: #D8DEE9FF">openssl req </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">new </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">key </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\verification.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\verification.csr</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">subj </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">/CN=</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootVerCode</span><span style="color: #ECEFF4">&quot;</span></span>
<span class="line"><span style="color: #D8DEE9FF">openssl x509 </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">req </span><span style="color: #81A1C1">-in</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\verification.csr</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">CA </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\root-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">CAkey </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\root-ca.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">CAcreateserial </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\verification.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">days </span><span style="color: #B48EAD">1</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">sha256</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Verify root CA in DPS:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$rootEtag = $rootVer.properties.etag\naz iot dps certificate verify \u002d\u002ddps-name $dpsName \u002d\u002dresource-group $resourceGroup \u002d\u002dcertificate-name $rootCertName \u002d\u002dpath \u0022$certDir\u005croot\u005cverification.pem\u0022 \u002d\u002detag $rootEtag\nWrite-Host \u0022✓ Root CA verified in DPS\u0022 -ForegroundColor Green","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootEtag\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootVer.properties.etag\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz iot dps certificate verify \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edps\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003edpsName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecertificate\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootCertName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003epath \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005croot\u005cverification.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eetag \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003erootEtag\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eWrite-Host\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e✓ Root CA verified in DPS\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eForegroundColor Green\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$rootEtag = $rootVer.properties.etag
az iot dps certificate verify --dps-name $dpsName --resource-group $resourceGroup --certificate-name $rootCertName --path "$certDir\root\verification.pem" --etag $rootEtag
Write-Host "✓ Root CA verified in DPS" -ForegroundColor Green</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootEtag</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootVer.properties.etag</span></span>
<span class="line"><span style="color: #D8DEE9FF">az iot dps certificate verify </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">dps</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">certificate</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootCertName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">path </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\verification.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">etag </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">rootEtag</span></span>
<span class="line"><span style="color: #88C0D0">Write-Host</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">✓ Root CA verified in DPS</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">ForegroundColor Green</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>5) Upload and verify intermediate CA with DPS:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Upload intermediate CA to DPS:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$caCertName = \u0022$registrationId-intermediate\u0022\naz iot dps certificate create \u002d\u002ddps-name $dpsName \u002d\u002dresource-group $resourceGroup \u002d\u002dcertificate-name $caCertName \u002d\u002dpath \u0022$certDir\u005cca\u005cintermediate-ca.pem\u0022","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaCertName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eregistrationId\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e-intermediate\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz iot dps certificate create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edps\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003edpsName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecertificate\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaCertName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003epath \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$caCertName = "$registrationId-intermediate"
az iot dps certificate create --dps-name $dpsName --resource-group $resourceGroup --certificate-name $caCertName --path "$certDir\ca\intermediate-ca.pem"</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caCertName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">registrationId</span><span style="color: #A3BE8C">-intermediate</span><span style="color: #ECEFF4">&quot;</span></span>
<span class="line"><span style="color: #D8DEE9FF">az iot dps certificate create </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">dps</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">certificate</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caCertName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">path </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.pem</span><span style="color: #ECEFF4">&quot;</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Get intermediate CA etag and generate verification code:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$caCert = az iot dps certificate show \u002d\u002ddps-name $dpsName \u002d\u002dresource-group $resourceGroup \u002d\u002dcertificate-name $caCertName -o json | ConvertFrom-Json\n$caEtag = $caCert.properties.etag\n\n$caVer = az iot dps certificate generate-verification-code \u002d\u002ddps-name $dpsName \u002d\u002dresource-group $resourceGroup \u002d\u002dcertificate-name $caCertName \u002d\u002detag $caEtag -o json | ConvertFrom-Json\n$caVerCode = $caVer.properties.verificationCode\nWrite-Host \u0022Verification Code: $caVerCode\u0022 -ForegroundColor Cyan","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaCert\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e az iot dps certificate show \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edps\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003edpsName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecertificate\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaCertName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eo json \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e|\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eConvertFrom-Json\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaEtag\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaCert.properties.etag\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaVer\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e az iot dps certificate generate\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003everification\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecode \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edps\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003edpsName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecertificate\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaCertName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eetag \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaEtag\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eo json \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e|\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eConvertFrom-Json\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaVerCode\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaVer.properties.verificationCode\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eWrite-Host\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003eVerification Code: \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaVerCode\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eForegroundColor Cyan\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$caCert = az iot dps certificate show --dps-name $dpsName --resource-group $resourceGroup --certificate-name $caCertName -o json | ConvertFrom-Json
$caEtag = $caCert.properties.etag

$caVer = az iot dps certificate generate-verification-code --dps-name $dpsName --resource-group $resourceGroup --certificate-name $caCertName --etag $caEtag -o json | ConvertFrom-Json
$caVerCode = $caVer.properties.verificationCode
Write-Host "Verification Code: $caVerCode" -ForegroundColor Cyan</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caCert</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> az iot dps certificate show </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">dps</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">certificate</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caCertName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">o json </span><span style="color: #81A1C1">|</span><span style="color: #D8DEE9FF"> </span><span style="color: #88C0D0">ConvertFrom-Json</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caEtag</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caCert.properties.etag</span></span>
<span class="line"></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caVer</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> az iot dps certificate generate</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">verification</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">code </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">dps</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">certificate</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caCertName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">etag </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caEtag</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">o json </span><span style="color: #81A1C1">|</span><span style="color: #D8DEE9FF"> </span><span style="color: #88C0D0">ConvertFrom-Json</span></span>
<span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caVerCode</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caVer.properties.verificationCode</span></span>
<span class="line"><span style="color: #88C0D0">Write-Host</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">Verification Code: </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caVerCode</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">ForegroundColor Cyan</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Create intermediate CA verification certificate:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"openssl genrsa -out \u0022$certDir\u005cca\u005cverification.key\u0022 2048\nopenssl req -new -key \u0022$certDir\u005cca\u005cverification.key\u0022 -out \u0022$certDir\u005cca\u005cverification.csr\u0022 -subj \u0022/CN=$caVerCode\u0022\nopenssl x509 -req -in \u0022$certDir\u005cca\u005cverification.csr\u0022 -CA \u0022$certDir\u005cca\u005cintermediate-ca.pem\u0022 -CAkey \u0022$certDir\u005cca\u005cintermediate-ca.key\u0022 -CAcreateserial -out \u0022$certDir\u005cca\u005cverification.pem\u0022 -days 1 -sha256","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl genrsa \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eout \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cverification.key\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #B48EAD\u0022\u003e2048\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl req \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003enew \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ekey \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cverification.key\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eout \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cverification.csr\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003esubj \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e/CN=\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaVerCode\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl x509 \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ereq \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-in\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cverification.csr\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eCA \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eCAkey \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.key\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eCAcreateserial \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eout \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cverification.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edays \u003c/span\u003e\u003cspan style=\u0022color: #B48EAD\u0022\u003e1\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003esha256\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>openssl genrsa -out "$certDir\ca\verification.key" 2048
openssl req -new -key "$certDir\ca\verification.key" -out "$certDir\ca\verification.csr" -subj "/CN=$caVerCode"
openssl x509 -req -in "$certDir\ca\verification.csr" -CA "$certDir\ca\intermediate-ca.pem" -CAkey "$certDir\ca\intermediate-ca.key" -CAcreateserial -out "$certDir\ca\verification.pem" -days 1 -sha256</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">openssl genrsa </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\verification.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #B48EAD">2048</span></span>
<span class="line"><span style="color: #D8DEE9FF">openssl req </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">new </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">key </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\verification.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\verification.csr</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">subj </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">/CN=</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caVerCode</span><span style="color: #ECEFF4">&quot;</span></span>
<span class="line"><span style="color: #D8DEE9FF">openssl x509 </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">req </span><span style="color: #81A1C1">-in</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\verification.csr</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">CA </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">CAkey </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">CAcreateserial </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\verification.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">days </span><span style="color: #B48EAD">1</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">sha256</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Verify intermediate CA in DPS:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"$caEtag = $caVer.properties.etag\naz iot dps certificate verify \u002d\u002ddps-name $dpsName \u002d\u002dresource-group $resourceGroup \u002d\u002dcertificate-name $caCertName \u002d\u002dpath \u0022$certDir\u005cca\u005cverification.pem\u0022 \u002d\u002detag $caEtag\nWrite-Host \u0022✓ Intermediate CA verified in DPS\u0022 -ForegroundColor Green","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaEtag\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e=\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaVer.properties.etag\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz iot dps certificate verify \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edps\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003edpsName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecertificate\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaCertName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003epath \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cverification.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eetag \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecaEtag\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eWrite-Host\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e✓ Intermediate CA verified in DPS\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eForegroundColor Green\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>$caEtag = $caVer.properties.etag
az iot dps certificate verify --dps-name $dpsName --resource-group $resourceGroup --certificate-name $caCertName --path "$certDir\ca\verification.pem" --etag $caEtag
Write-Host "✓ Intermediate CA verified in DPS" -ForegroundColor Green</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caEtag</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">=</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caVer.properties.etag</span></span>
<span class="line"><span style="color: #D8DEE9FF">az iot dps certificate verify </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">dps</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">certificate</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caCertName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">path </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\verification.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">etag </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">caEtag</span></span>
<span class="line"><span style="color: #88C0D0">Write-Host</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">✓ Intermediate CA verified in DPS</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">ForegroundColor Green</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p>6<strong>) Create device bootstrap certificate:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Create device private key and CSR:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"openssl genrsa -out \u0022$certDir\u005cdevice\u005cdevice.key\u0022 2048\nopenssl req -new -key \u0022$certDir\u005cdevice\u005cdevice.key\u0022 -out \u0022$certDir\u005cdevice\u005cdevice.csr\u0022 -subj \u0022/CN=$registrationId\u0022","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl genrsa \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eout \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cdevice\u005cdevice.key\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #B48EAD\u0022\u003e2048\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl req \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003enew \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ekey \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cdevice\u005cdevice.key\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eout \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cdevice\u005cdevice.csr\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003esubj \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e/CN=\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eregistrationId\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>openssl genrsa -out "$certDir\device\device.key" 2048
openssl req -new -key "$certDir\device\device.key" -out "$certDir\device\device.csr" -subj "/CN=$registrationId"</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">openssl genrsa </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\device\device.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #B48EAD">2048</span></span>
<span class="line"><span style="color: #D8DEE9FF">openssl req </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">new </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">key </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\device\device.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\device\device.csr</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">subj </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">/CN=</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">registrationId</span><span style="color: #ECEFF4">&quot;</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Create device extensions file:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"@\u0022\n[ v3_req ]\nbasicConstraints = CA:FALSE\nkeyUsage = critical, digitalSignature, keyEncipherment\nextendedKeyUsage = clientAuth\nsubjectAltName = DNS:$registrationId\nauthorityKeyIdentifier = keyid:always,issuer\n\u0022@ | Set-Content -Path \u0022$certDir\u005cdevice\u005cdevice-ext.cnf\u0022 -Encoding ASCII","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e@\u0026quot;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u0026#91; v3_req \u0026#93;\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003ebasicConstraints = CA:FALSE\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003ekeyUsage = critical, digitalSignature, keyEncipherment\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003eextendedKeyUsage = clientAuth\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003esubjectAltName = DNS:\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eregistrationId\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003eauthorityKeyIdentifier = keyid:always,issuer\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;@\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e|\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eSet-Content\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ePath \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cdevice\u005cdevice-ext.cnf\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eEncoding ASCII\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>@"
&#91; v3_req &#93;
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = clientAuth
subjectAltName = DNS:$registrationId
authorityKeyIdentifier = keyid:always,issuer
"@ | Set-Content -Path "$certDir\device\device-ext.cnf" -Encoding ASCII</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #ECEFF4">@&quot;</span></span>
<span class="line"><span style="color: #A3BE8C">&#91; v3_req &#93;</span></span>
<span class="line"><span style="color: #A3BE8C">basicConstraints = CA:FALSE</span></span>
<span class="line"><span style="color: #A3BE8C">keyUsage = critical, digitalSignature, keyEncipherment</span></span>
<span class="line"><span style="color: #A3BE8C">extendedKeyUsage = clientAuth</span></span>
<span class="line"><span style="color: #A3BE8C">subjectAltName = DNS:</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">registrationId</span></span>
<span class="line"><span style="color: #A3BE8C">authorityKeyIdentifier = keyid:always,issuer</span></span>
<span class="line"><span style="color: #ECEFF4">&quot;@</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">|</span><span style="color: #D8DEE9FF"> </span><span style="color: #88C0D0">Set-Content</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">Path </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\device\device-ext.cnf</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">Encoding ASCII</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Sign device certificate with intermediate CA:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"openssl x509 -req -in \u0022$certDir\u005cdevice\u005cdevice.csr\u0022 -CA \u0022$certDir\u005cca\u005cintermediate-ca.pem\u0022 -CAkey \u0022$certDir\u005cca\u005cintermediate-ca.key\u0022 -out \u0022$certDir\u005cdevice\u005cdevice.pem\u0022 -days 365 -sha256 -extfile \u0022$certDir\u005cdevice\u005cdevice-ext.cnf\u0022 -extensions v3_req","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl x509 \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ereq \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-in\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cdevice\u005cdevice.csr\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eCA \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eCAkey \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.key\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eout \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cdevice\u005cdevice.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edays \u003c/span\u003e\u003cspan style=\u0022color: #B48EAD\u0022\u003e365\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003esha256 \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eextfile \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cdevice\u005cdevice-ext.cnf\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eextensions v3_req\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>openssl x509 -req -in "$certDir\device\device.csr" -CA "$certDir\ca\intermediate-ca.pem" -CAkey "$certDir\ca\intermediate-ca.key" -out "$certDir\device\device.pem" -days 365 -sha256 -extfile "$certDir\device\device-ext.cnf" -extensions v3_req</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">openssl x509 </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">req </span><span style="color: #81A1C1">-in</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\device\device.csr</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">CA </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">CAkey </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.key</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">out </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\device\device.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">days </span><span style="color: #B48EAD">365</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">sha256 </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">extfile </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\device\device-ext.cnf</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">extensions v3_req</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>Create certificate chain files:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"Get-Content \u0022$certDir\u005cca\u005cintermediate-ca.pem\u0022, \u0022$certDir\u005croot\u005croot-ca.pem\u0022 | Set-Content -Path \u0022$certDir\u005cdevice\u005cchain.pem\u0022 -Encoding ASCII\nGet-Content \u0022$certDir\u005cdevice\u005cdevice.pem\u0022, \u0022$certDir\u005cca\u005cintermediate-ca.pem\u0022, \u0022$certDir\u005croot\u005croot-ca.pem\u0022 | Set-Content -Path \u0022$certDir\u005cdevice\u005cdevice-full-chain.pem\u0022 -Encoding ASCII\nWrite-Host \u0022✓ Device bootstrap certificate created\u0022 -ForegroundColor Green","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eGet-Content\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e,\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005croot\u005croot-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e|\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eSet-Content\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ePath \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cdevice\u005cchain.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eEncoding ASCII\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eGet-Content\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cdevice\u005cdevice.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e,\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cca\u005cintermediate-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e,\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005croot\u005croot-ca.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e|\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eSet-Content\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ePath \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003ecertDir\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e\u005cdevice\u005cdevice-full-chain.pem\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eEncoding ASCII\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eWrite-Host\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e✓ Device bootstrap certificate created\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eForegroundColor Green\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>Get-Content "$certDir\ca\intermediate-ca.pem", "$certDir\root\root-ca.pem" | Set-Content -Path "$certDir\device\chain.pem" -Encoding ASCII
Get-Content "$certDir\device\device.pem", "$certDir\ca\intermediate-ca.pem", "$certDir\root\root-ca.pem" | Set-Content -Path "$certDir\device\device-full-chain.pem" -Encoding ASCII
Write-Host "✓ Device bootstrap certificate created" -ForegroundColor Green</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #88C0D0">Get-Content</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">,</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\root-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">|</span><span style="color: #D8DEE9FF"> </span><span style="color: #88C0D0">Set-Content</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">Path </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\device\chain.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">Encoding ASCII</span></span>
<span class="line"><span style="color: #88C0D0">Get-Content</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\device\device.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">,</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\ca\intermediate-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">,</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\root\root-ca.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">|</span><span style="color: #D8DEE9FF"> </span><span style="color: #88C0D0">Set-Content</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">Path </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">certDir</span><span style="color: #A3BE8C">\device\device-full-chain.pem</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">Encoding ASCII</span></span>
<span class="line"><span style="color: #88C0D0">Write-Host</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">✓ Device bootstrap certificate created</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">ForegroundColor Green</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>7) Create DPS enrollment group:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"az iot dps enrollment-group create \u002d\u002ddps-name $dpsName \u002d\u002dresource-group $resourceGroup \u002d\u002denrollment-id $enrollmentGroupName \u002d\u002dca-name \u0022$registrationId-intermediate\u0022 \u002d\u002dcredential-policy \u0022default\u0022 \u002d\u002dprovisioning-status enabled\n\nWrite-Host \u0022✓ Enrollment group created with CSR-based certificate issuance\u0022 -ForegroundColor Green","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eaz iot dps enrollment\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup create \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003edps\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003edpsName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eresource\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003egroup \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eresourceGroup\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eenrollment\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eid \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eenrollmentGroupName\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eca\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ename \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9\u0022\u003eregistrationId\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e-intermediate\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ecredential\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003epolicy \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003edefault\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e\u002d\u002d\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eprovisioning\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003estatus enabled\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #88C0D0\u0022\u003eWrite-Host\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #A3BE8C\u0022\u003e✓ Enrollment group created with CSR-based certificate issuance\u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eForegroundColor Green\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e","language":"powershell","theme":"nord","bgColor":"#2e3440ff","textColor":"#d8dee9ff","fontSize":".875rem","fontFamily":"Code-Pro-JetBrains-Mono","lineHeight":"1.25rem","clampFonts":false,"lineNumbers":false,"headerType":"none","disablePadding":false,"footerType":"none","enableMaxHeight":false,"seeMoreType":"","seeMoreString":"","seeMoreAfterLine":"","seeMoreTransition":false,"seeMoreCollapse":false,"seeMoreCollapseString":"","highlightingHover":false,"lineHighlightColor":"rgba(201, 218, 248, 0.2)","copyButton":true,"copyButtonType":"heroicons","copyButtonUseTextarea":true,"useTabs":false} -->
<div class="wp-block-kevinbatdorf-code-block-pro" data-code-block-pro-font-family="Code-Pro-JetBrains-Mono" style="font-size:.875rem;font-family:Code-Pro-JetBrains-Mono,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;line-height:1.25rem;--cbp-tab-width:2;tab-size:var(--cbp-tab-width, 2)"><span role="button" tabindex="0" style="color:#d8dee9ff;display:none" aria-label="Copy" class="code-block-pro-copy-button"><pre class="code-block-pro-copy-button-pre" aria-hidden="true"><textarea class="code-block-pro-copy-button-textarea" tabindex="-1" aria-hidden="true" readonly>az iot dps enrollment-group create --dps-name $dpsName --resource-group $resourceGroup --enrollment-id $enrollmentGroupName --ca-name "$registrationId-intermediate" --credential-policy "default" --provisioning-status enabled

Write-Host "✓ Enrollment group created with CSR-based certificate issuance" -ForegroundColor Green</textarea></pre><svg xmlns="http://www.w3.org/2000/svg" style="width:24px;height:24px" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path class="with-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path><path class="without-check" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg></span><pre class="shiki nord" style="background-color: #2e3440ff" tabindex="0"><code><span class="line"><span style="color: #D8DEE9FF">az iot dps enrollment</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group create </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">dps</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">dpsName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">resource</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">group </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">resourceGroup</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">enrollment</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">id </span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">enrollmentGroupName</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">ca</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">name </span><span style="color: #ECEFF4">&quot;</span><span style="color: #81A1C1">$</span><span style="color: #D8DEE9">registrationId</span><span style="color: #A3BE8C">-intermediate</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">credential</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">policy </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">default</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">--</span><span style="color: #D8DEE9FF">provisioning</span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">status enabled</span></span>
<span class="line"></span>
<span class="line"><span style="color: #88C0D0">Write-Host</span><span style="color: #D8DEE9FF"> </span><span style="color: #ECEFF4">&quot;</span><span style="color: #A3BE8C">✓ Enrollment group created with CSR-based certificate issuance</span><span style="color: #ECEFF4">&quot;</span><span style="color: #D8DEE9FF"> </span><span style="color: #81A1C1">-</span><span style="color: #D8DEE9FF">ForegroundColor Green</span></span></code></pre></div>
<!-- /wp:kevinbatdorf/code-block-pro -->

<!-- wp:paragraph -->
<p><strong>8) Deploy to device:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>Copy to your device:</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li><code>$certDir\device\device.pem</code>&nbsp;- Bootstrap certificate</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li><code>$certDir\device\device.key</code>&nbsp;- Device private key</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li><code>$certDir\device\device-full-chain.pem</code>&nbsp;- Full certificate chain</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph -->
<p>Store keys securely (TPM/secure element if available).</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading" id="setup-complete">Setup Complete</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>You've now completed all manual setup steps:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>✓ Certificate Authority Chain Created:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Root CA (uploaded and verified in DPS)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Intermediate CA (uploaded and verified in DPS)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Device bootstrap certificate (signed by intermediate CA)</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph -->
<p><strong>✓ DPS Enrollment Configured:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Enrollment group linked to intermediate CA</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>CSR-based certificate issuance enabled</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Ready for device provisioning</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph -->
<p><strong>Certificate Files Created:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Root:&nbsp;<code>$certDir\root\root-ca.pem</code></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Intermediate:&nbsp;<code>$certDir\ca\intermediate-ca.pem</code></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Device:&nbsp;<code>$certDir\device\device.pem</code></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Device Key:&nbsp;<code>$certDir\device\device.key</code></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>TLS Chain:&nbsp;<code>$certDir\device\chain.pem</code>&nbsp;(intermediate + root)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Full Chain:&nbsp;<code>$certDir\device\device-full-chain.pem</code>&nbsp;(leaf + intermediate + root)</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph -->
<p><strong>What Happens Next:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:list {"ordered":true} -->
<ol class="wp-block-list"><!-- wp:list-item -->
<li>Deploy&nbsp;<code>device.pem</code>,&nbsp;<code>device.key</code>, and&nbsp;<code>device-full-chain.pem</code>&nbsp;to your device</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Device boots and authenticates to DPS with bootstrap certificate</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Device generates new key pair and submits Certificate Signing Request (CSR)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>DPS forwards CSR to ADR issuing CA (via credential policy)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>ADR issues operational certificate (Phase 2)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Device receives operational certificate from DPS</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Device uses operational certificate for all IoT Hub connections</li>
<!-- /wp:list-item --></ol>
<!-- /wp:list -->

<!-- wp:paragraph -->
<p><strong>For Detailed Explanations:</strong>&nbsp;See&nbsp;<a href="https://www.petecodes.co.uk/iot-hub-with-adr-and-certificate-management-part-4a">Understanding X.509 and CSR Workflows (Deep Dive)</a>&nbsp;for complete technical details, certificate architecture, and advanced scenarios.</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading" id="certificate-renewal">Certificate Renewal</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Devices are responsible for monitoring operational certificate expiration:</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Check&nbsp;<code>Valid until</code>&nbsp;date periodically</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Initiate renewal before expiration (recommended: 7 days before)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Generate new CSR and submit to DPS (same as initial provisioning)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Receive renewed certificate from ADR</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph -->
<p><strong>Best Practice:</strong>&nbsp;Use Device Twin reported properties to track certificate issuance/expiration dates for monitoring.</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading" id="preview-limitations">Preview Limitations</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>⚠️&nbsp;<strong>Certificate Revocation:</strong>&nbsp;Not supported in preview - disable device in IoT Hub instead <br>⚠️&nbsp;<strong>Production Use:</strong>&nbsp;Not recommended during preview <br>⚠️&nbsp;<strong>SDK Support:</strong>&nbsp;Official Microsoft C# SDKs don't yet support&nbsp;<code>2025-07-01-preview</code>&nbsp;API</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading" id="learn-more">Learn More</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p><strong>Official Microsoft Documentation:</strong></p>
<!-- /wp:paragraph -->

