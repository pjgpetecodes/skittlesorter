<!-- wp:paragraph -->
<p><strong>2) Create root and intermediate CA:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Create root CA certificate (self-signed):</strong></p>
<!-- /wp:paragraph -->

<!-- wp:kevinbatdorf/code-block-pro {"code":"openssl req -x509 -new -nodes -newkey rsa:4096 `\n  -keyout \u0022$certDir\u005croot\u005croot-ca.key\u0022 `\n  -out \u0022$certDir\u005croot\u005croot-ca.pem\u0022 `\n  -days 3650 -sha256 `\n  -subj \u0022/CN=$registrationId-root\u0022 `\n  -addext \u0022basicConstraints=critical,CA:true,pathlen:1\u0022 `\n  -addext \u0022keyUsage=critical,keyCertSign,cRLSign\u0022 `\n  -addext \u0022subjectKeyIdentifier=hash\u0022 `\n  -addext \u0022authorityKeyIdentifier=keyid:always\u0022","codeHTML":"\u003cpre class=\u0022shiki nord\u0022 style=\u0022background-color: #2e3440ff\u0022 tabindex=\u00220\u0022\u003e\u003ccode\u003e\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003eopenssl req \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ex509 \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003enew \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003enodes \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003enewkey rsa:\u003c/span\u003e\u003cspan style=\u0022color: #B48EAD\u0022\u003e4096\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e`\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\u0022line\u0022\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003e  \u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e-\u003c/span\u003e\u003cspan style=\u0022color: #D8DEE9FF\u0022\u003ekeyout \u003c/span\u003e\u003cspan style=\u0022color: #ECEFF4\u0022\u003e\u0026quot;\u003c/span\u003e\u003cspan style=\u0022color: #81A1C1\u0022\u003e$\u003c/span\u003e\u003cspan style=\u0022col