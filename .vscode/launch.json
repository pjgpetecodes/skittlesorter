            "preLaunchTask": "build",
            "program": "${workspaceFolder}\\bin\\Debug\\net10.0\\skittlesorter.dll",
            "args": [
                "--cloud-self-test"
            ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "SkittleSorter SAS Profile",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}\\bin\\Debug\\net10.0\\skittlesorter.dll",
            "args": [
                "--config",
                "${workspaceFolder}\\appsettings.sas.json"
            ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "SkittleSorter X.509 Profile",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}\\bin\\Debug\\net10.0\\skittlesorter.dll",
            "args": [
                "--config",
                "${workspaceFolder}\\appsettings.x509.json"
            ],
