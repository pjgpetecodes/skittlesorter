{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SkittleSorter (appsettings.002.json)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}\\bin\\Debug\\net10.0\\skittlesorter.dll",
            "args": [
                "--config",
                "${workspaceFolder}\\appsettings.002.json"
            ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "SkittleSorter Cloud Self-Test (appsettings.002.json)",
