{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SkittleSorter (appsettings.json)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}\\bin\\Debug\\net10.0\\skittlesorter.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "SkittleSorter Cloud Self-Test",
            "type": "coreclr",
