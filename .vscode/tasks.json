            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}\\scripts\\demo-reset.ps1",
                "-Scenario",
                "FullBootstrap",
                "-TargetPath",
                "${workspaceFolder}\\scripts\\demo-target.local.json",
                "-Confirm"
            ],
            "problemMatcher": []
        },
        {
            "label": "Demo: Preview full bootstrap reset",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
