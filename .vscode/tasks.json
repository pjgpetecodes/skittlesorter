{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}\\skittlesorter.csproj",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Demo: Set up X.509 bootstrap (after full reset)",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}\\scripts\\demo-setup.ps1",
                "-TargetPath",
                "${workspaceFolder}\\scripts\\demo-target.local.json",
                "-Confirm"
            ],
            "problemMatcher": []
        },
        {
            "label": "Demo: Preview X.509 bootstrap setup",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}\\scripts\\demo-setup.ps1",
                "-TargetPath",
                "${workspaceFolder}\\scripts\\demo-target.local.json",
                "-WhatIf"
            ],
            "problemMatcher": []
        },
        {
            "label": "Demo: Reset cloud device state",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}\\scripts\\demo-reset.ps1",
                "-Scenario",
                "CloudOnly",
                "-TargetPath",
                "${workspaceFolder}\\scripts\\demo-target.local.json",
                "-Confirm"
            ],
            "problemMatcher": []
        },
        {
            "label": "Demo: Preview cloud device reset",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
