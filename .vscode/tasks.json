                "-WhatIf"
            ],
            "problemMatcher": []
        },
        {
            "label": "Demo: Reset operational identity",
            "type": "process",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}\\scripts\\demo-reset.ps1",
                "-Scenario",
                "OperationalIdentity",
                "-TargetPath",
                "${workspaceFolder}\\scripts\\demo-target.local.json",
                "-Confirm"
            ],
            "problemMatcher": []
        },
        {
            "label": "Demo: Preview operational identity reset",
            "type": "process",
            "command": "pwsh",
