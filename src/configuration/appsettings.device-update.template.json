{
  "Hardware": {
    "MockMode": {
      "EnableMockColorSensor": true,
      "EnableMockServos": true,
      "MockColorSequence": ["Red", "Green", "None", "Purple"]
    },
    "ServoPositions": {
      "PickAngle": 0,
      "DetectAngle": 90,
      "DropAngle": 180
    },
    "ChutePositions": {
      "Red": 22,
      "Green": 44,
      "Purple": 66,
      "Yellow": 88,
      "Orange": 112
    }
  },
  "IoTHub": {
    "DeviceId": "{RegistrationId}",
    "SendTelemetry": false,
    "DpsProvisioning": {
      "ProvisioningHost": "global.azure-devices-provisioning.net",
      "IdScope": "<YOUR_GA_DPS_ID_SCOPE>",
      "RegistrationId": "skittlesorter-ga",
      "AttestationMethod": "SymmetricKey",
      "DeviceKeyBase64": "<YOUR_DERIVED_DEVICE_KEY>",
      "RequestOperationalCertificate": false,
      "AutoGenerateCsr": false,
      "EnableDebugLogging": false
    }
  },
  "Adr": {
    "Enabled": false
  }
}
